# Application Settings
APP_NAME=The Trust Layer
ENVIRONMENT=development
DEBUG=false

# Security (Generate strong random values for production)
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# Database
DATABASE_URL=sqlite:///./trust_layer.db

# Trust ID & Session Settings
TRUST_ID_EXPIRY_MINUTES=5
CUSTOMER_SESSION_EXPIRY_MINUTES=30
PUBLIC_RATE_LIMIT_PER_MINUTE=30
MAX_AUDIO_UPLOAD_BYTES=10485760

# AI Provider Settings ("mock" or "detectifai")
AI_PROVIDER=mock
MOCK_VOICE_PASS_THRESHOLD=0.75
MOCK_DEEPFAKE_MAX_RISK=0.35

# DetectifAI Aletheia + Eidos (https://platform.detectif.ai)
DETECTIFAI_API_BASE_URL=https://platform.detectif.ai
DETECTIFAI_API_KEY=

# Initial Platform Admin Seed (Used by scripts/seed_demo.py)
SEED_ADMIN_EMAIL=admin@trustlayer.demo
SEED_ADMIN_PASSWORD=AdminTrust!2026ChangeMe
